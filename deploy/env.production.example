CODEATLAS_ENV=production
CODEATLAS_DATA_DIR=/var/lib/codeatlas
CODEATLAS_DATABASE_URL=mysql+pymysql://codeatlas:change-me@127.0.0.1:3306/codeatlas?charset=utf8mb4
CODEATLAS_PUBLIC_ORIGIN=https://codeatlas.example.com
CODEATLAS_COOKIE_SECURE=true
CODEATLAS_ALLOWED_GIT_HOSTS=github.com,gitee.com
CODEATLAS_MCP_ALLOWED_HOSTS=codeatlas.example.com,127.0.0.1:*,localhost:*
# Explicitly authorize private Confluence Data Center hosts when required.
CODEATLAS_ALLOWED_EXTERNAL_HOSTS=
CODEATLAS_EMBEDDING_MODE=hash
CODEATLAS_EMBEDDING_BASE_URL=
CODEATLAS_EMBEDDING_API_KEY=
CODEATLAS_EMBEDDING_MODEL=hash-embedding-v1
CODEATLAS_EMBEDDING_DIMENSION=1024
# Embedding credentials can be encrypted through the HTTPS admin UI. A protected
# environment reference remains available as an operations-managed fallback.
# CODEATLAS_CREDENTIAL_SILICONFLOW_EMBEDDING=replace-with-the-real-key
CODEATLAS_MAX_REPOSITORY_MB=200
CODEATLAS_MAX_SOURCE_FILES=20000
CODEATLAS_GIT_TIMEOUT_SECONDS=180
# External source credentials are JSON objects resolved by reference name.
# Never commit real values; install them only in the protected server environment.
# CODEATLAS_CREDENTIAL_AWS_DOCS='{"access_key_id":"...","secret_access_key":"..."}'
# CODEATLAS_CREDENTIAL_COS_DOCS='{"secret_id":"...","secret_key":"..."}'
# CODEATLAS_CREDENTIAL_NOTION_ENGINEERING='{"token":"..."}'
# CODEATLAS_CREDENTIAL_CONFLUENCE_ENGINEERING='{"email":"admin@example.com","api_token":"..."}'
