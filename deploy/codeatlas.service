[Unit]
Description=CodeAtlas API and MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codeatlas
Group=codeatlas
WorkingDirectory=/opt/codeatlas/backend
EnvironmentFile=/etc/codeatlas/codeatlas.env
Environment=HOME=/var/lib/codeatlas
ExecStartPre=/opt/codeatlas/backend/.venv/bin/alembic -c /opt/codeatlas/backend/alembic.ini upgrade head
ExecStart=/opt/codeatlas/backend/.venv/bin/uvicorn codeatlas.app:create_app --factory --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=4s
TimeoutStartSec=120s
TimeoutStopSec=45s
KillSignal=SIGINT
MemoryHigh=550M
MemoryMax=700M
TasksMax=128
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/codeatlas
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
