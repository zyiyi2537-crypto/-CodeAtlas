CODEATLAS_ENV=development
CODEATLAS_DATA_DIR=./data
CODEATLAS_DATABASE_URL=mysql+pymysql://codeatlas:change-me@127.0.0.1:3306/codeatlas?charset=utf8mb4
CODEATLAS_PUBLIC_ORIGIN=http://127.0.0.1:4321
CODEATLAS_COOKIE_SECURE=false
CODEATLAS_ALLOWED_GIT_HOSTS=github.com,gitee.com
CODEATLAS_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# Optional explicit allowlist for private Confluence Data Center hosts.
CODEATLAS_ALLOWED_EXTERNAL_HOSTS=
CODEATLAS_EMBEDDING_MODE=hash
CODEATLAS_EMBEDDING_BASE_URL=
CODEATLAS_EMBEDDING_API_KEY=
CODEATLAS_EMBEDDING_MODEL=hash-embedding-v1
CODEATLAS_EMBEDDING_DIMENSION=1024
# Preferred server-side credential for the SiliconFlow BGE-M3 Profile UI preset.
# CODEATLAS_CREDENTIAL_SILICONFLOW_EMBEDDING=replace-with-the-real-key
CODEATLAS_LLM_BASE_URL=https://api.kimi.com/coding/v1
CODEATLAS_LLM_API_KEY=
CODEATLAS_LLM_MODEL=kimi-for-coding
CODEATLAS_MAX_REPOSITORY_MB=200
CODEATLAS_MAX_SOURCE_FILES=20000
CODEATLAS_GIT_TIMEOUT_SECONDS=180
# External source credentials are JSON objects resolved by reference name.
# AWS example: '{"access_key_id":"...","secret_access_key":"...","session_token":""}'
# CODEATLAS_CREDENTIAL_AWS_DOCS=
# COS example: '{"secret_id":"...","secret_key":"...","token":""}'
# CODEATLAS_CREDENTIAL_COS_DOCS=
# Notion example: '{"token":"..."}'
# CODEATLAS_CREDENTIAL_NOTION_ENGINEERING=
# Confluence Cloud: '{"email":"admin@example.com","api_token":"..."}'
# Confluence Data Center: '{"personal_access_token":"..."}'
# CODEATLAS_CREDENTIAL_CONFLUENCE_ENGINEERING=
