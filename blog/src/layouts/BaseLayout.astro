---
interface Props {
  title?: string
  description?: string
  image?: string
  article?: boolean
}

const {
  title = 'CodeAtlas',
  description = '企业级私有代码知识库、混合检索与 MCP 工程实践。',
  image = '/images/codeatlas-search.png',
  article = false,
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title === 'CodeAtlas' ? title : `${title} · CodeAtlas`
const imageUrl = new URL(image, Astro.site)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7f8" />
    <link rel="icon" href="/codeatlas-favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="CodeAtlas RSS" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-brand" href="/" aria-label="CodeAtlas 首页">
          <img class="brand-logo" src="/codeatlas-mark.svg" alt="" width="32" height="32" />
          <span>CodeAtlas</span>
        </a>
        <nav aria-label="站点导航">
          <a href="/#articles">文章</a>
          <a href="/about/">关于</a>
          <a class="demo-link" href="/lab/code-kb/">进入控制台 <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>CodeAtlas</strong>
        <span>Private code knowledge, made retrievable.</span>
      </div>
      <div class="footer-links">
        <a href="/rss.xml">RSS</a>
        <a href="/sitemap-index.xml">Sitemap</a>
        <a href="/lab/code-kb/">控制台</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color: #1d2328;
    background: #f5f7f8;
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-synthesis: none;
    letter-spacing: 0;
    --surface: #ffffff;
    --border: #dbe2e5;
    --text: #1d2328;
    --muted: #657179;
    --accent: #176b4d;
    --accent-dark: #10563d;
    --blue: #245f89;
  }

  * {
    box-sizing: border-box;
    letter-spacing: 0;
  }

  html {
    min-width: 320px;
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background: #f5f7f8;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    z-index: 30;
    top: 0;
    height: 62px;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    width: min(1180px, calc(100% - 48px));
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0 auto;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 760;
  }

  .brand-logo {
    width: 32px;
    height: 32px;
    display: block;
    flex: 0 0 32px;
  }

  .site-header nav,
  .footer-links {
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--muted);
    font-size: 13px;
  }

  .site-header nav a:hover,
  .footer-links a:hover {
    color: var(--accent);
  }

  .demo-link {
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    color: #ffffff !important;
    background: var(--accent);
    border-radius: 5px;
    font-weight: 680;
  }

  .demo-link:hover {
    background: var(--accent-dark);
  }

  .site-footer {
    min-height: 130px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 28px max(24px, calc((100% - 1180px) / 2));
    color: #cad3cf;
    background: #1b2421;
  }

  .site-footer > div:first-child {
    display: grid;
    gap: 5px;
  }

  .site-footer strong {
    color: #ffffff;
  }

  .site-footer span,
  .site-footer a {
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .header-inner {
      width: calc(100% - 28px);
    }

    .site-brand,
    .demo-link,
    .footer-links a {
      min-height: 44px;
    }

    .site-header nav > a:not(.demo-link) {
      display: none;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
